# Copy to .env and fill in. Never commit .env.

# Provider: "openai_compat" (Gemini OpenAI endpoint, Groq, OpenRouter, Ollama, OpenAI).
# Only openai_compat is implemented in Phase 1.
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Check current model IDs and free-tier limits with the provider before running
LLM_MODEL=gemini-3.5-flash-lite

GEMINI_API_KEY=

# Alternatives: set LLM_BASE_URL / LLM_MODEL to match, e.g.
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
#   OpenAI: LLM_BASE_URL=https://api.openai.com/v1
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# FHIR endpoints
MEDAGENTBENCH_FHIR_BASE=http://localhost:8080/fhir/
MOCK_FHIR_BASE=http://localhost:8081/fhir/
